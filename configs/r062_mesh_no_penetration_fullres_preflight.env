# Native 1920x1080 two-step R062 active-path preflight. It exercises the same
# renderer and backward path as the formal run with every gated R061 geometry
# and Gaussian-appearance parameter active.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r062_mesh_no_penetration_0_30k.env
source "${CONFIG_DIR}/r062_mesh_no_penetration_0_30k.env"
unset CONFIG_DIR

ITERATIONS=2
EVAL_EVERY=2
SAVE_EVERY=2
STAGE_SAVE_ITERS=2
TRAIN_VIEWS=9
TEST_VIEWS=9

GUIDE_FREEZE_UNTIL=0
GUIDE_RESIDUAL_UNLOCK_START=0
GUIDE_RESIDUAL_UNLOCK_END=1
SHAPE_DETAIL_FREEZE_UNTIL=0
SHAPE_DETAIL_UNLOCK_END=1
SECONDARY_SHAPE_RESIDUAL_UNLOCK_START=0
SECONDARY_SHAPE_RESIDUAL_UNLOCK_END=1
GAUSSIAN_RGB_RESIDUAL_INITIAL_MULTIPLIER=1.0
GAUSSIAN_RGB_RESIDUAL_UNLOCK_START=0
GAUSSIAN_RGB_RESIDUAL_UNLOCK_END=1
