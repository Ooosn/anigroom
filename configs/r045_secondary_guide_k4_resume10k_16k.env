# R045 causal diagnostic: resume the formal R044 10k state and change only
# the secondary-guide smoothing stencil from K32 to K4.  G1 population,
# render-to-G1 interpolation, losses, schedules, optimizer state, and data are
# inherited unchanged from R044.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r044_secondary_guide_residual_0_30k.env
source "${CONFIG_DIR}/r044_secondary_guide_residual_0_30k.env"
unset CONFIG_DIR

ITERATIONS=16000
SECONDARY_GUIDE_SMOOTH_K=4
STAGE_SAVE_ITERS=12000\,14000\,16000
