# R053 treatment: explicit shape detail and Gaussian RGB residual share one
# appearance/geometry handoff. Everything else is inherited from R050.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r050_gaussian_rgb_residual_0_30k.env
source "${CONFIG_DIR}/r050_gaussian_rgb_residual_0_30k.env"
unset CONFIG_DIR

# The rendered curl/frizz field is exactly zero through 10k. From 10k to 20k,
# its multiplier follows the same linear schedule as the Gaussian RGB residual.
SHAPE_DETAIL_FREEZE_UNTIL=10000
GUIDE_RESIDUAL_UNLOCK_START=10000
GUIDE_RESIDUAL_UNLOCK_END=20000
SHAPE_CURL_SCALE=1.0
SHAPE_FRIZZ_SCALE=1.0
GUIDE_CURL_RESIDUAL_SCALE=1.0
GUIDE_FRIZZ_RESIDUAL_SCALE=1.0

GAUSSIAN_RGB_RESIDUAL_INITIAL_MULTIPLIER=0.0
GAUSSIAN_RGB_RESIDUAL_UNLOCK_START=10000
GAUSSIAN_RGB_RESIDUAL_UNLOCK_END=20000
