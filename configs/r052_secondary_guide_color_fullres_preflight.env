# Native-resolution active-path preflight only. This is not a metric run.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r052_secondary_guide_color_gaussian_residual_0_30k.env
source "${CONFIG_DIR}/r052_secondary_guide_color_gaussian_residual_0_30k.env"
unset CONFIG_DIR

ITERATIONS=1
EVAL_EVERY=1
SAVE_EVERY=1
STAGE_SAVE_ITERS=1
TRAIN_VIEWS=9
TEST_VIEWS=9

# Exercise both the structured base and generated-Gaussian residual backward
# paths in the same native-resolution optimizer step.
GAUSSIAN_RGB_RESIDUAL_INITIAL_MULTIPLIER=1.0
GAUSSIAN_RGB_RESIDUAL_UNLOCK_START=1
GAUSSIAN_RGB_RESIDUAL_UNLOCK_END=2
