# R052 single-variable color-ownership experiment.
#
# R050 geometry, lifecycle, losses, resolution, and Gaussian RGB residual are
# unchanged. The low/mid-frequency root-tip color field moves from individual
# render roots to the existing fixed 20k secondary guides. Those colors learn
# through 10k and then freeze as the unchanged Gaussian residual ramps in.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r050_gaussian_rgb_residual_0_30k.env
source "${CONFIG_DIR}/r050_gaussian_rgb_residual_0_30k.env"
unset CONFIG_DIR

LOCAL_CHILD_COLOR_SUPPORT=0
SECONDARY_GUIDE_COLOR_SUPPORT=1
