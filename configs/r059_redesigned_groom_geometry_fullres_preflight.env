# Full-resolution two-step active-path preflight for R059. This is a gate for
# the formal from-zero run, not a reduced-resolution training substitute.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r059_redesigned_groom_geometry_0_30k.env
source "${CONFIG_DIR}/r059_redesigned_groom_geometry_0_30k.env"
unset CONFIG_DIR

ITERATIONS=2
EVAL_EVERY=2
SAVE_EVERY=2
STAGE_SAVE_ITERS=2
TRAIN_VIEWS=9
TEST_VIEWS=9

GUIDE_FREEZE_UNTIL=0
GUIDE_RESIDUAL_UNLOCK_START=0
GUIDE_RESIDUAL_UNLOCK_END=1
SHAPE_DETAIL_FREEZE_UNTIL=0
SHAPE_DETAIL_UNLOCK_END=1
SECONDARY_SHAPE_RESIDUAL_UNLOCK_START=0
SECONDARY_SHAPE_RESIDUAL_UNLOCK_END=1
GAUSSIAN_RGB_RESIDUAL_INITIAL_MULTIPLIER=1.0
GAUSSIAN_RGB_RESIDUAL_UNLOCK_START=0
GAUSSIAN_RGB_RESIDUAL_UNLOCK_END=1
