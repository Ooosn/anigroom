# R079 3k->4k continuation. Preserve the complete R074 V8 contract and
# release only primary-guide length after the historical 3k checkpoint.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r074_v8_confidence_flow_0_3k_gate.env
source "${CONFIG_DIR}/r074_v8_confidence_flow_0_3k_gate.env"

ITERATIONS=4000
GUIDE_LENGTH_FREEZE_UNTIL=3000
STAGE_SAVE_ITERS=4000

unset CONFIG_DIR
