# R080 one-step resume preflight. Inherit the all-guide continuation contract
# and run only the 3000->3001 boundary with the migrated R074 checkpoint.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r080_all_guide_unlock_at3k_resume.env
source "${CONFIG_DIR}/r080_all_guide_unlock_at3k_resume.env"

ITERATIONS=3001
STAGE_SAVE_ITERS=3001
SAVE_EVERY=0
TRAIN_VIEWS=9
TEST_VIEWS=9

unset CONFIG_DIR
