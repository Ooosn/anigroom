# Local RGB-groom V11 appearance-from-9k branch.
#
# Purpose:
# - resume from the accepted 9k checkpoint, before curl/frizz starts affecting
#   the white-tiger structure;
# - keep the baseline coverage/length release schedule from 30k_rgbflow;
# - add bounded child-strand appearance residual so RGB shadows/noise/stripe
#   detail do not have to be represented by curl, frizz, or over-bent geometry.
#
# This intentionally does not inherit V1/V10's strong length anchor. V10 proved
# that locking coverage/length after 9k drops 10k composite PSNR from the
# baseline 28.4 range to ~24.
source "$(dirname "${BASH_SOURCE[0]}")/white_tiger_stage1_cleanflow_multiview_30k_rgbflow.env"

ITERATIONS=30000
EVAL_EVERY=1000
SAVE_EVERY=3000
STAGE_SAVE_ITERS=10000,12000,14000,16000,20000,25000,30000

# Follow the successful baseline topology/coverage schedule. Length must remain
# free enough to recover from the conservative shell initialization.
GUIDE_FREEZE_UNTIL=9000
GUIDE_COVERAGE_RESIDUAL_UNLOCK_START=1000
GUIDE_COVERAGE_RESIDUAL_UNLOCK_END=7000
GUIDE_RESIDUAL_UNLOCK_START=10000
GUIDE_RESIDUAL_UNLOCK_END=20000
GUIDE_LENGTH_RESIDUAL_SCALE=0.18
GUIDE_FLOW_RESIDUAL_SCALE=0.10
GUIDE_WIDTH_RESIDUAL_SCALE=0.06
GUIDE_FLOW_STRENGTH_RESIDUAL_SCALE=0.08
GUIDE_LIFT_RESIDUAL_SCALE=0.08
GUIDE_STIFFNESS_RESIDUAL_SCALE=0.08
GUIDE_CHILD_RADIUS_RESIDUAL_SCALE=0.04
GUIDE_CLUMP_RESIDUAL_SCALE=0.04

# Curl/frizz are the failure mode on ordinary tiger fur. Keep them disabled for
# this branch. Bend is delayed and weaker than the baseline, so broad grooming
# curvature can appear later without letting RGB stripes create loops.
SHAPE_DETAIL_FREEZE_UNTIL=14000
SHAPE_BEND_SCALE=0.50
SHAPE_CURL_SCALE=0.0
SHAPE_FRIZZ_SCALE=0.0
GUIDE_BEND_RESIDUAL_SCALE=0.04
GUIDE_CURL_RESIDUAL_SCALE=0.0
GUIDE_FRIZZ_RESIDUAL_SCALE=0.0

# Appearance handoff: bounded child-strand color residual only. Opacity residual
# stays off, so the branch cannot hide coverage or depth errors using alpha.
LOCAL_CHILD_COLOR_SUPPORT=1
LOCAL_CHILD_COLOR_SCALE=0.15
LOCAL_CHILD_OPACITY_SUPPORT=0
LOCAL_CHILD_OPACITY_SCALE=0.0
LR_COLOR=0.020

# Keep clean-flow as a structural prior, not a length lock.
CLEAN_FLOW_ANCHOR_WEIGHT=0.016
CLEAN_FLOW_GUIDE_ANCHOR_WEIGHT=0.080
CLEAN_FLOW_3D_SMOOTH_WEIGHT=0.014
CLEAN_FLOW_LENGTH_ANCHOR_WEIGHT=0.0
GUIDE_PRIOR_WEIGHT=0.045
GUIDE_PRIOR_LENGTH_WEIGHT=2.40
GUIDE_PRIOR_WIDTH_WEIGHT=0.60
GUIDE_PRIOR_CHILD_RADIUS_WEIGHT=0.35
GUIDE_SMOOTH_WEIGHT=0.080
SMOOTH_WEIGHT=0.018
STRAND_SHAPE_SMOOTH_WEIGHT=0.003
EFFECTIVE_SMOOTH_WEIGHT=0.0
SHAPE_PRIOR_WEIGHT=0.016

# Same evidence-driven lifecycle as the accepted baseline. No luma/screen/
# overlong hard-coded stroke routes.
DENSIFY_WARMUP=600
DENSIFY_INTERVAL=100
DENSIFY_UNTIL=10000
MAX_SPLITS_PER_EVENT=512
GUIDE_DENSIFY_START=11000
GUIDE_DENSIFY_INTERVAL=200
GUIDE_DENSIFY_UNTIL=16000
GUIDE_DENSIFY_MAX_SPLITS_PER_EVENT=32

OVERPAINT_CAPACITY_WEIGHT=0.0
DARK_STROKE_CAPACITY_WEIGHT=0.0
SCREEN_STROKE_CAPACITY_WEIGHT=0.0
NEUTRAL_SCREEN_CAPACITY_WEIGHT=0.0
COLOR_CONTRAST_CAPACITY_WEIGHT=0.0
EARLY_CAPACITY_WEIGHT=0.0
EFFECTIVE_GEOMETRY_BUDGET_WEIGHT=0.0
OVERLONG_SPLIT_UNTIL=0
OVERLONG_SPLIT_LENGTH_THRESHOLD=0
OVERLONG_SPLIT_WIDTH_THRESHOLD=0
OVERLONG_SPLIT_OPACITY_THRESHOLD=0
OVERLONG_SPLIT_MIN_CONTRIBUTION=0
OVERLONG_SPLIT_MAX_PARENTS_PER_EVENT=0
SCREEN_FOOTPRINT_SPLIT_DIAG_THRESHOLD=0
SCREEN_FOOTPRINT_SPLIT_EXTRA_PARENTS_PER_EVENT=0
SCREEN_FOOTPRINT_SPLIT_NEUTRAL_EXTRA_PARENTS_PER_EVENT=0
