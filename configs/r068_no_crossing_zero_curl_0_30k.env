# R068 is the formal no-crossing child of the exact R067 config.
# Crossing query and exact-pair batches remain inherited and inert because
# STRAND_CROSSING_SUPPORT is disabled; only the three active crossing values
# below are changed.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r067_no_frizz_0_30k.env
source "${CONFIG_DIR}/r067_no_frizz_0_30k.env"

STRAND_CROSSING_SUPPORT=0
STRAND_CROSSING_WEIGHT=0
STRAND_CROSSING_REFRESH_INTERVAL=0

unset CONFIG_DIR
