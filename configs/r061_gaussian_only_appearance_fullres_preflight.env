# Full-resolution two-step R061 active-path preflight. This validates that the
# obsolete per-render-root color delta is absent while the generated-Gaussian
# RGB residual still receives optimizer state and gradients.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r061_gaussian_only_appearance_0_30k.env
source "${CONFIG_DIR}/r061_gaussian_only_appearance_0_30k.env"
unset CONFIG_DIR

ITERATIONS=2
EVAL_EVERY=2
SAVE_EVERY=2
STAGE_SAVE_ITERS=2
TRAIN_VIEWS=9
TEST_VIEWS=9

GUIDE_FREEZE_UNTIL=0
GUIDE_RESIDUAL_UNLOCK_START=0
GUIDE_RESIDUAL_UNLOCK_END=1
SHAPE_DETAIL_FREEZE_UNTIL=0
SHAPE_DETAIL_UNLOCK_END=1
SECONDARY_SHAPE_RESIDUAL_UNLOCK_START=0
SECONDARY_SHAPE_RESIDUAL_UNLOCK_END=1
GAUSSIAN_RGB_RESIDUAL_INITIAL_MULTIPLIER=1.0
GAUSSIAN_RGB_RESIDUAL_UNLOCK_START=0
GAUSSIAN_RGB_RESIDUAL_UNLOCK_END=1
