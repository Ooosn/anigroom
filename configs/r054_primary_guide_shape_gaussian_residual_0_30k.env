# R054 single-variable child of R053 treatment.
#
# Curl and frizz remain editable shape controls, but their ownership is reduced
# to the smooth primary-guide field. The secondary-guide geometry residual no
# longer carries either attribute. Gaussian RGB residual and the shared
# 10k-20k handoff are unchanged.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r053_shape_detail_gaussian_residual_0_30k.env
source "${CONFIG_DIR}/r053_shape_detail_gaussian_residual_0_30k.env"
unset CONFIG_DIR

GUIDE_CURL_RESIDUAL_SCALE=0.0
GUIDE_FRIZZ_RESIDUAL_SCALE=0.0
