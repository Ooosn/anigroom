# R059 is the strict from-zero training validation of the accepted R058 strand
# geometry on the complete R057 training contract.
#
# This file intentionally assigns no behavior value. Data, initialization,
# interpolation, losses, schedules, lifecycle, density, learning rates, and
# gradient ownership are inherited byte-for-byte from R057. The only method
# variable is the R058 source implementation of curl/frizz geometry.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r057_rgb_flow_no_color_grad_0_30k.env
source "${CONFIG_DIR}/r057_rgb_flow_no_color_grad_0_30k.env"
unset CONFIG_DIR
