# Clean-flow ablation for the formal 100k/low-guide Stage 1 route.
# This keeps the baseline config intact and only adds the cleaned 3D flow
# initialization/anchor/smooth terms for view09.
source "$(dirname "${BASH_SOURCE[0]}")/white_tiger_stage1_formal.env"

# Current accepted flow / initialization module target.
# Keep this aligned with docs/anigroom_module_map.md and
# docs/modules/01_flow_initialization.md.
CLEAN_FLOW_TARGET=_downloads/tiger_hair_flow_36/shell_fused_smal_head500_body4000_candidate65536_headk24_bodyk12_v4_surface_direction/guide_flow3d_shell_targets_exclude_004_024_025.npz
CLEAN_FLOW_INIT=1
CLEAN_FLOW_INIT_LIFT=1
CLEAN_FLOW_INIT_K=8
CLEAN_FLOW_INIT_MIN_CONFIDENCE=0.03
CLEAN_FLOW_ANCHOR_MIN_CONFIDENCE=0.35
CLEAN_FLOW_LIFT_MIN=0.008
CLEAN_FLOW_LIFT_MAX=0.040
CLEAN_FLOW_LENGTH_INIT=1
CLEAN_FLOW_LENGTH_INIT_SCALE=0.30
CLEAN_FLOW_LENGTH_INIT_MIN_CONFIDENCE=0.50
CLEAN_FLOW_LENGTH_INIT_MIN=0.010
CLEAN_FLOW_LENGTH_INIT_MAX=0.040

# Clean-flow targets already contain the accepted SMAL/anatomy-aware guide
# control points. Training must use those same points, otherwise the flow
# module and guide interpolation module disagree before optimization starts.
GUIDE_ROOT_COUNT=4500
GUIDE_ROOTS_FROM_CLEAN_FLOW=1

# Keep these moderate: this is a 3D direction prior, not a replacement for RGB.
CLEAN_FLOW_ANCHOR_WEIGHT=0.020
CLEAN_FLOW_GUIDE_ANCHOR_WEIGHT=0.080
CLEAN_FLOW_3D_SMOOTH_WEIGHT=0.012

# New structural ablation path: keep guide interpolation in 3D direction space,
# delay bend/curl/frizz fitting, and compare RGB-derived image-flow loss against
# the older strand-splat orientation loss.
GUIDE_DIRECTION_PRIMARY=1
SHAPE_DETAIL_FREEZE_UNTIL=1400
RGB_FLOW_WEIGHT=0.020
RGB_FLOW_DETAIL_WEIGHT=0.010
RGB_FLOW_MIN_CONFIDENCE=0.10
