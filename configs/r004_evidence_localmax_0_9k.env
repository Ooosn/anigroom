# R004 phase A: R003 baseline with topology-local evidence densification.
#
# Single intended delta from R003:
# - replace target_direct pixel insertion with root lifecycle split/delete;
# - parent roots are selected by absolute root evidence, then filtered by
#   mesh-topology local maxima.
#
# Because lifecycle split creates two children and removes the selected parent,
# the event budget is doubled to keep the maximum net root growth comparable to
# R003 target_direct insertion.
source "$(dirname "${BASH_SOURCE[0]}")/v11_v4_parent_0_9k.env"

DENSIFY_PARENT_SELECTION=evidence_local_max
MAX_SPLITS_PER_EVENT=1024
