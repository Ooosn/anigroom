# R077 confidence-owned guide-length gate. Preserve R076's V8 target,
# short-scale initialization, early length release, and 0-3k contract while
# adding only geometry ownership and the data-relative length anchor.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r076_early_guide_length_0_3k_gate.env
source "${CONFIG_DIR}/r076_early_guide_length_0_3k_gate.env"

VIEW_GATE_GEOMETRY_SUPPORT=1
CLEAN_FLOW_GUIDE_LENGTH_ANCHOR_WEIGHT=0.080

unset CONFIG_DIR
