# R071 diagnostic gate: add only primary-guide-owned degree-one RGB SH to the
# exact R068 behavior. Geometry, lifecycle, roots, losses, and schedules remain
# unchanged. The run stops at 9k because the Panda multiview defect is already
# visible before guide geometry unlocks.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r068_no_crossing_zero_curl_0_30k.env
source "${CONFIG_DIR}/r068_no_crossing_zero_curl_0_30k.env"

GUIDE_SUPPORT_GAUGE_WEIGHT=0
GUIDE_VIEW_SH_SUPPORT=1
GUIDE_VIEW_SH_SCALE=0.20
LR_GUIDE_VIEW_SH=0.020

ITERATIONS=9000
SAVE_EVERY=3000
STAGE_SAVE_ITERS=3000,6000,9000

unset CONFIG_DIR
