# R049 promotion gate: continue the exact corrected R048 state from 16k to
# the formal 30k endpoint. No model, loss, lifecycle, interpolation, or
# regularization setting changes relative to R048.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r048_secondary_guide_regularized_vector_transport_resume10k_16k.env
source "${CONFIG_DIR}/r048_secondary_guide_regularized_vector_transport_resume10k_16k.env"
unset CONFIG_DIR

ITERATIONS=30000
STAGE_SAVE_ITERS=18000\,20000\,22000\,25000\,27000\,30000

