# R076 early guide-length gate. Preserve R074's formal V8 target, equal-owner
# view budget, 400000-root population, 0.30 clean-flow initialization, and
# 0-3k training contract. Release only guide length at iteration zero so the
# other guide attributes remain under R074's inherited freeze.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r074_v8_confidence_flow_0_3k_gate.env
source "${CONFIG_DIR}/r074_v8_confidence_flow_0_3k_gate.env"

GUIDE_LENGTH_FREEZE_UNTIL=0

unset CONFIG_DIR
