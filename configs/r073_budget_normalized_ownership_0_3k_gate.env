# R073 diagnostic gate: preserve R072's exact trusted owner support while
# normalizing each guide's owner multipliers to conserve expected gradient mass
# under uniform sampling of the 30 training views. No floor, SH, new confidence,
# loss, or lifecycle schedule is added. The first run stops at 3k because rare
# guides with one owner receive the principled 30x importance multiplier.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r072_view_gated_ownership_0_9k_gate.env
source "${CONFIG_DIR}/r072_view_gated_ownership_0_9k_gate.env"

VIEW_GATE_NORMALIZATION=equal_owner_budget
ITERATIONS=3000
SAVE_EVERY=3000
STAGE_SAVE_ITERS=3000

unset CONFIG_DIR
