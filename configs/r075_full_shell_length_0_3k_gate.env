# R075 bounded data-identity length gate. Preserve R074's exact V8 target,
# ownership, training, lifecycle, identity, and asset contract, changing only
# the clean-flow length initialization scale.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r074_v8_confidence_flow_0_3k_gate.env
source "${CONFIG_DIR}/r074_v8_confidence_flow_0_3k_gate.env"

CLEAN_FLOW_LENGTH_INIT_SCALE=1.0

unset CONFIG_DIR
