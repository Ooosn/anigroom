# R053 matched control. The representation and optimizer still contain the
# Gaussian RGB residual, but its multiplier is exactly zero through 30k.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r053_shape_detail_gaussian_residual_0_30k.env
source "${CONFIG_DIR}/r053_shape_detail_gaussian_residual_0_30k.env"
unset CONFIG_DIR

GAUSSIAN_RGB_RESIDUAL_INITIAL_MULTIPLIER=0.0
GAUSSIAN_RGB_RESIDUAL_UNLOCK_START=30000
GAUSSIAN_RGB_RESIDUAL_UNLOCK_END=30001

