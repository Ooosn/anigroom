# Formal Stage1 multiview route using the surface-consistent clean-flow target.
#
# This config is intentionally RGB-flow-only for image-domain structure:
# - no strand-splat orientation map loss;
# - no old dark/screen/luma hardcoded stroke routes;
# - short clean-flow shell length initialization is enabled and then residual
#   length is released gradually.
source "$(dirname "${BASH_SOURCE[0]}")/white_tiger_stage1_cleanflow_view09.env"

unset TRAIN_VIEWS
unset TEST_VIEWS

ITERATIONS=30000
EVAL_EVERY=1000
SAVE_EVERY=5000
STAGE_SAVE_ITERS=9000,10000,16000,20000,25000,30000

# Short, data-derived initialization.  The shell height is a thickness cue, not
# a final length target, so it starts conservative and training can grow it.
INIT_GROOM_LENGTH=0.018
INIT_GUIDE_LENGTH=0.018
CLEAN_FLOW_LENGTH_INIT=1
CLEAN_FLOW_LENGTH_INIT_SCALE=0.30
CLEAN_FLOW_LENGTH_INIT_MIN_CONFIDENCE=0.50
CLEAN_FLOW_LENGTH_INIT_MIN=0.010
CLEAN_FLOW_LENGTH_INIT_MAX=0.040

# Keep render-root density high; guide roots come from the accepted clean-flow
# module and are used as smooth structure controls.
ROOT_COUNT=100000
GUIDE_ROOT_COUNT=4500
GUIDE_ROOTS_FROM_CLEAN_FLOW=1
CHILD_COUNT=4

# Multi-view must not use the older render_orientation_map path.  The remaining
# structure evidence is the differentiable RGB-derived flow computed from pred
# and cached target RGB.
ORIENTATION_WEIGHT=0.0
ORIENTATION_DETAIL_WEIGHT=0.0
RGB_FLOW_WEIGHT=0.012
RGB_FLOW_DETAIL_WEIGHT=0.006
RGB_FLOW_MIN_CONFIDENCE=0.10

# Stage1-A: grow coverage while guide controls stay stable.
# Stage1-B: release render-root residuals and high-frequency shape after enough
# roots exist, so RGB does not solve missing coverage by making long curls.
GUIDE_FREEZE_UNTIL=9000
SHAPE_DETAIL_FREEZE_UNTIL=9000
SHAPE_BEND_SCALE=1.0
SHAPE_CURL_SCALE=1.0
SHAPE_FRIZZ_SCALE=1.0
GUIDE_RESIDUAL_INITIAL_MULTIPLIER=0.0
GUIDE_RESIDUAL_UNLOCK_START=10000
GUIDE_RESIDUAL_UNLOCK_END=20000
GUIDE_COVERAGE_RESIDUAL_INITIAL_MULTIPLIER=0.0
GUIDE_COVERAGE_RESIDUAL_UNLOCK_START=1000
GUIDE_COVERAGE_RESIDUAL_UNLOCK_END=7000

# Length residual is required; otherwise root length is fixed to guide/base and
# cannot correct the conservative shell initialization.
GUIDE_LENGTH_RESIDUAL_SCALE=0.18
GUIDE_BEND_RESIDUAL_SCALE=0.08
GUIDE_FLOW_RESIDUAL_SCALE=0.10
GUIDE_WIDTH_RESIDUAL_SCALE=0.06
GUIDE_FLOW_STRENGTH_RESIDUAL_SCALE=0.08
GUIDE_LIFT_RESIDUAL_SCALE=0.08
GUIDE_STIFFNESS_RESIDUAL_SCALE=0.08
GUIDE_CHILD_RADIUS_RESIDUAL_SCALE=0.04
GUIDE_CLUMP_RESIDUAL_SCALE=0.04
GUIDE_CURL_RESIDUAL_SCALE=0.035
GUIDE_FRIZZ_RESIDUAL_SCALE=0.025

# Anchor is a prior, not a lock.  Keep it active early but loose enough for
# multi-view RGB to correct shell/gpt alignment errors.
CLEAN_FLOW_ANCHOR_WEIGHT=0.016
CLEAN_FLOW_GUIDE_ANCHOR_WEIGHT=0.080
CLEAN_FLOW_3D_SMOOTH_WEIGHT=0.014
GUIDE_PRIOR_WEIGHT=0.045
GUIDE_PRIOR_LENGTH_WEIGHT=2.40
GUIDE_PRIOR_WIDTH_WEIGHT=0.60
GUIDE_PRIOR_CHILD_RADIUS_WEIGHT=0.35
GUIDE_SMOOTH_WEIGHT=0.080
SMOOTH_WEIGHT=0.018
STRAND_SHAPE_SMOOTH_WEIGHT=0.003
EFFECTIVE_SMOOTH_WEIGHT=0.0
SHAPE_PRIOR_WEIGHT=0.016

# The inherited single-view checkpoint used early/effective capacity targets to
# force visibility quickly.  In 30k multiview they caused length/width
# compensation before coverage had stabilized, so the formal route lets RGB,
# clean-flow priors, and densification drive coverage instead.
EARLY_CAPACITY_WEIGHT=0.0
EFFECTIVE_GEOMETRY_BUDGET_WEIGHT=0.0

# Coverage schedule for 30k: densification happens early/mid, then stops so
# later optimization settles geometry and color instead of constantly changing
# topology.
DENSIFY_WARMUP=600
DENSIFY_INTERVAL=100
DENSIFY_UNTIL=10000
MAX_SPLITS_PER_EVENT=512
GUIDE_DENSIFY_START=11000
GUIDE_DENSIFY_INTERVAL=200
GUIDE_DENSIFY_UNTIL=16000
GUIDE_DENSIFY_MAX_SPLITS_PER_EVENT=32

# Keep the old hardcoded capacity/stroke routes disabled in this formal pass.
OVERPAINT_CAPACITY_WEIGHT=0.0
DARK_STROKE_CAPACITY_WEIGHT=0.0
SCREEN_STROKE_CAPACITY_WEIGHT=0.0
NEUTRAL_SCREEN_CAPACITY_WEIGHT=0.0
COLOR_CONTRAST_CAPACITY_WEIGHT=0.0
OVERLONG_SPLIT_UNTIL=0
OVERLONG_SPLIT_LENGTH_THRESHOLD=0
OVERLONG_SPLIT_MAX_PARENTS_PER_EVENT=0
