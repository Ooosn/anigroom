# R061 removes the obsolete per-render-root color delta from the accepted R060
# contract. With child_count=1, that field is not a child appearance control;
# it is one extra RGB offset per independent render root and competes directly
# with the true generated-Gaussian RGB residual.
#
# Every geometry field, loss, schedule, lifecycle event, density, learning rate,
# camera, input, and Gaussian-residual setting is inherited unchanged. This is
# a strict from-zero experiment.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r060_relative_shape_amplitudes_0_30k.env
source "${CONFIG_DIR}/r060_relative_shape_amplitudes_0_30k.env"
unset CONFIG_DIR

LOCAL_CHILD_COLOR_SUPPORT=0
