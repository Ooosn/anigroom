# R074 target-only gate. Preserve R073's exact equal-owner-budget training
# contract and replace only the external clean-flow target with the formally
# accepted V8 confidence-guided directed field supplied by the launcher.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r073_budget_normalized_ownership_0_3k_gate.env
source "${CONFIG_DIR}/r073_budget_normalized_ownership_0_3k_gate.env"

# No executable variable changes are allowed here. CLEAN_FLOW_TARGET is an
# explicit launcher input whose V8 schema/hash is verified before preflight.

unset CONFIG_DIR
