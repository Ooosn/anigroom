# Full-resolution R051 implementation preflight only.
#
# This is not an experiment result and must never be used for metric claims.
# It preserves the formal 400k-root representation, real white-tiger data,
# 1920x1080 rendering, mesh depth/backing, losses, and backward path, while
# forcing the Gaussian residual active for one real view09 optimizer step.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r051_guide_color_gaussian_residual_0_30k.env
source "${CONFIG_DIR}/r051_guide_color_gaussian_residual_0_30k.env"
unset CONFIG_DIR

ITERATIONS=1
EVAL_EVERY=1
SAVE_EVERY=1
STAGE_SAVE_ITERS=1
TRAIN_VIEWS=9
TEST_VIEWS=9

GAUSSIAN_RGB_RESIDUAL_INITIAL_MULTIPLIER=1.0
GAUSSIAN_RGB_RESIDUAL_UNLOCK_START=0
GAUSSIAN_RGB_RESIDUAL_UNLOCK_END=1
