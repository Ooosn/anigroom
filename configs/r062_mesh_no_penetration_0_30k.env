# R062 is a strict single-variable child of accepted R061. It adds only the
# continuous-strand mesh no-penetration loss. All appearance, geometry,
# lifecycle, density, camera, renderer, and optimization settings remain R061.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r061_gaussian_only_appearance_0_30k.env
source "${CONFIG_DIR}/r061_gaussian_only_appearance_0_30k.env"
unset CONFIG_DIR

MESH_NO_PENETRATION_SUPPORT=1
MESH_NO_PENETRATION_SDF="${MESH_NO_PENETRATION_SDF:?set the reviewed mesh SDF path}"
MESH_NO_PENETRATION_WEIGHT=256
MESH_NO_PENETRATION_ROOT_BATCH=16384
