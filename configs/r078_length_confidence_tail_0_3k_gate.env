# R078 length-confidence tail gate. Preserve R077's V8 target, geometry
# ownership, confidence-weighted anchor, short initialization, early length
# release, non-length freezes, and bounded 0-3k contract while isolating
# render-path length-confidence gating and tail-concentration reduction.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r077_confidence_owned_length_0_3k_gate.env
source "${CONFIG_DIR}/r077_confidence_owned_length_0_3k_gate.env"

VIEW_GATE_LENGTH_CONFIDENCE_SUPPORT=1
CLEAN_FLOW_GUIDE_LENGTH_ANCHOR_REDUCTION=tail_concentration

unset CONFIG_DIR
