# Full-resolution active-path preflight only. This is not a metric result.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r053_shape_detail_gaussian_residual_0_30k.env
source "${CONFIG_DIR}/r053_shape_detail_gaussian_residual_0_30k.env"
unset CONFIG_DIR

ITERATIONS=1
EVAL_EVERY=1
SAVE_EVERY=1
STAGE_SAVE_ITERS=1
TRAIN_VIEWS=9
TEST_VIEWS=9

# Force both new active paths on for one real 1920x1080 forward/backward step.
GUIDE_FREEZE_UNTIL=0
GUIDE_RESIDUAL_UNLOCK_START=0
GUIDE_RESIDUAL_UNLOCK_END=1
SHAPE_DETAIL_FREEZE_UNTIL=0
GAUSSIAN_RGB_RESIDUAL_INITIAL_MULTIPLIER=1.0
GAUSSIAN_RGB_RESIDUAL_UNLOCK_START=0
GAUSSIAN_RGB_RESIDUAL_UNLOCK_END=1
