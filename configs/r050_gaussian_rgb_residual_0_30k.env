# R050 single-variable appearance experiment.
#
# Geometry, losses, lifecycle, interpolation, and all schedules match the
# validated R049 structural parent. The only new representation is a
# per-render-root normalized arc-length RGB profile sampled by each generated
# Gaussian segment. The existing root/tip and local render-root colors remain.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r044_secondary_guide_residual_0_30k.env
source "${CONFIG_DIR}/r044_secondary_guide_residual_0_30k.env"
unset CONFIG_DIR

# R049's validated local secondary-geometry stencil and formal endpoint.
SECONDARY_GUIDE_SMOOTH_K=4
ITERATIONS=30000
STAGE_SAVE_ITERS=9000\,10000\,12000\,14000\,16000\,18000\,20000\,22000\,25000\,27000\,30000

# True generated-Gaussian RGB residual. A zero multiplier is an exact no-op;
# the common 10k-20k unlock matches the geometry handoff without a new stage.
GAUSSIAN_RGB_RESIDUAL_SUPPORT=1
GAUSSIAN_RGB_RESIDUAL_CONTROL_POINTS=36
GAUSSIAN_RGB_RESIDUAL_SCALE=0.20
GAUSSIAN_RGB_RESIDUAL_INITIAL_MULTIPLIER=0.0
GAUSSIAN_RGB_RESIDUAL_UNLOCK_START=10000
GAUSSIAN_RGB_RESIDUAL_UNLOCK_END=20000
