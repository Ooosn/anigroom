# R060 is the strict from-zero length-relative curl/frizz experiment.
#
# R059 remains frozen. Data, initialization evidence, losses, schedules,
# lifecycle, density, learning rates, and gradient ownership are inherited
# without a behavior assignment. The only method variable is that curl radius
# and frizz amplitude are optimized as dimensionless fractions of each
# strand's current length.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r059_redesigned_groom_geometry_0_30k.env
source "${CONFIG_DIR}/r059_redesigned_groom_geometry_0_30k.env"
unset CONFIG_DIR
