# R067 is a clean removal of frizz from the differentiable reconstruction path.
# It inherits the accepted R066 contract, then removes exactly the two active
# frizz environment keys. This is not a scale-zero compatibility setting.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r066_learned_curl_turns_0_30k.env
source "${CONFIG_DIR}/r066_learned_curl_turns_0_30k.env"
unset GUIDE_FRIZZ_RESIDUAL_SCALE SHAPE_FRIZZ_SCALE
unset CONFIG_DIR
