# R072 diagnostic gate: add only per-view trusted ownership of render-root
# placement, opacity, and densification evidence to the exact R068 behavior.
# The rejected R069 support gauge and the rejected R071 guide SH stay disabled,
# so this candidate changes gradient ownership and nothing else.
#
# The run stops at 9k because the Panda multiview defect is already visible at
# 3k, well before guide length, width, and direction unlock.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r068_no_crossing_zero_curl_0_30k.env
source "${CONFIG_DIR}/r068_no_crossing_zero_curl_0_30k.env"

GUIDE_SUPPORT_GAUGE_WEIGHT=0
GUIDE_VIEW_SH_SUPPORT=0
VIEW_GATED_OWNERSHIP_SUPPORT=1
# 0.0 detaches untrusted roots for that view and leaves them to the
# view-independent surface regularizers. This is the single-variable setting.
VIEW_GATE_FLOOR=0.0

ITERATIONS=9000
SAVE_EVERY=3000
STAGE_SAVE_ITERS=3000,6000,9000

unset CONFIG_DIR
