# R056 decoupled image-evidence ownership.
#
# R055 remains immutable. Schedules, losses, weights, representation, residual
# capacity, interpolation, and lifecycle are inherited exactly. This flag only
# changes which parameter families receive the existing RGB and RGB-flow
# gradients once Gaussian appearance residual becomes active.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r055_staged_primary_secondary_shape_0_30k.env
source "${CONFIG_DIR}/r055_staged_primary_secondary_shape_0_30k.env"
unset CONFIG_DIR

DECOUPLED_RGB_FLOW_OWNERSHIP=1
