# R051 color-decomposition experiment.
#
# Geometry, lifecycle, losses, and schedules are inherited unchanged from
# R050. The appearance base moves from per-render-root colors to sparse
# primary-guide root/tip colors. Generated-Gaussian RGB residuals remain the
# only high-frequency color representation and take over after 10k.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r050_gaussian_rgb_residual_0_30k.env
source "${CONFIG_DIR}/r050_gaussian_rgb_residual_0_30k.env"
unset CONFIG_DIR

GUIDE_COLOR_SUPPORT=1
LOCAL_CHILD_COLOR_SUPPORT=0
