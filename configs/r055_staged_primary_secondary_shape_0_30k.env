# R055 staged shape ownership experiment.
#
# R054 remains the frozen parent. Length, width, direction, lifecycle, losses,
# interpolation, and learning rates are unchanged. The only experiment is a
# two-level curl/frizz handoff around the existing Gaussian RGB appearance
# outlet.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r054_primary_guide_shape_gaussian_residual_0_30k.env
source "${CONFIG_DIR}/r054_primary_guide_shape_gaussian_residual_0_30k.env"
unset CONFIG_DIR

# Primary-guide curl/frizz and Gaussian RGB residual enter together.
SHAPE_DETAIL_FREEZE_UNTIL=20000
SHAPE_DETAIL_UNLOCK_END=25000
GAUSSIAN_RGB_RESIDUAL_INITIAL_MULTIPLIER=0.0
GAUSSIAN_RGB_RESIDUAL_UNLOCK_START=20000
GAUSSIAN_RGB_RESIDUAL_UNLOCK_END=25000

# The denser secondary guide receives only zero-centered relative residuals,
# after the primary semantic field and appearance outlet are fully active.
GUIDE_CURL_RESIDUAL_SCALE=1.0
GUIDE_FRIZZ_RESIDUAL_SCALE=1.0
SECONDARY_SHAPE_RESIDUAL_UNLOCK_START=25000
SECONDARY_SHAPE_RESIDUAL_UNLOCK_END=30000
