# R057 single-variable child of the accepted R055 training line.
#
# Forward rendering, RGB-flow source, losses, weights, schedules, interpolation,
# lifecycle, capacity, and learning rates are inherited unchanged. Only the
# RGB-flow backward route excludes color parameters.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r055_staged_primary_secondary_shape_0_30k.env
source "${CONFIG_DIR}/r055_staged_primary_secondary_shape_0_30k.env"
unset CONFIG_DIR

RGB_FLOW_EXCLUDE_COLOR_GRADIENTS=1
