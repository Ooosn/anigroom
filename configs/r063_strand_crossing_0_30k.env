# R063 is a strict single-variable child of accepted R062. It adds only the
# differentiable inter-strand crossing active set. The weight is calibrated so
# its geometry-gradient L2 is about one third of the existing structural prior.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/r062_mesh_no_penetration_0_30k.env
source "${CONFIG_DIR}/r062_mesh_no_penetration_0_30k.env"
unset CONFIG_DIR

STRAND_CROSSING_SUPPORT=1
STRAND_CROSSING_WEIGHT=0.001
STRAND_CROSSING_REFRESH_INTERVAL=2000
STRAND_CROSSING_QUERY_BATCH=50000
STRAND_CROSSING_EXACT_PAIR_BATCH=250000
